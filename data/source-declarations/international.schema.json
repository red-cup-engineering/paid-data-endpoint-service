  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "id",
        "family",
        "title",
        "rights"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "family": {
          "enum": [
            "world-bank-indicator",
            "climate-hazards-archive",
            "licensed-exchange-data",
            "restricted-website",
            "controlled-station-network"
          ]
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "countryISO3": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "indicator": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9._-]{0,127}$"
        },
        "coverage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "sourceCredit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "rights": {
          "$ref": "#/$defs/rights"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "family": {
                "const": "world-bank-indicator"
              }
            }
          },
          "then": {
            "required": [
              "country",
              "countryISO3",
              "indicator",
              "unit",
              "sourceCredit"
            ],
            "properties": {
              "rights": {
                "required": [
                  "indicatorUrl"
                ]
              }
            }
          }
        }
      ]
    },
    "rights": {
      "type": "object",
      "required": [
        "state",
        "license",
        "checkedOn",
        "reviewBy",
        "termsUrl"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "qualified-for-conditional-resale",
            "qualified-source-unacquired-assets",
            "commercial-resale-held"
          ]
        },
        "license": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "checkedOn": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "format": "date"
        },
        "reviewBy": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "format": "date"
        },
        "termsUrl": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^https://[^/?#@]+(?:[/?][^#]*)?$",
          "format": "uri"
        },
        "indicatorUrl": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^https://[^/?#@]+(?:[/?][^#]*)?$",
          "format": "uri"
        },
        "attribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "obligations": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          }
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "qualified-for-conditional-resale",
                  "qualified-source-unacquired-assets"
                ]
              }
            }
          },
          "then": {
            "required": [
              "attribution",
              "obligations"
            ],
            "properties": {
              "license": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
              },
              "obligations": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}

