{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paid-data-endpoint-service/international-source-declarations",
  "title": "International data source declarations",
  "description": "Operator-selected source definitions and rights editions. Runtime admission also verifies matching map IDs, calendar dates, review windows, and reserved source identities.",
  "type": "object",
  "minProperties": 1,
  "maxProperties": 20000,
  "propertyNames": {
    "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
  },
  "additionalProperties": {
    "$ref": "#/$defs/source"
  },
  "properties": {
    "wdi-cn-gdp": {
      "allOf": [
        {
          "$ref": "#/$defs/source"
        },
        {
          "type": "object",
          "required": [
            "id",
            "family",
            "country",
            "indicator",
            "title",
            "unit",
            "sourceCredit",
            "countryISO3",
            "rights"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "const": "wdi-cn-gdp"
            },
            "family": {
              "const": "world-bank-indicator"
            },
            "country": {
              "const": "CN"
            },
            "indicator": {
              "const": "NY.GDP.MKTP.CD"
            },
            "title": {
              "const": "China GDP (current US$)"
            },
            "unit": {
              "const": "current US dollars"
            },
            "sourceCredit": {
              "const": "Country official statistics, national statistical organizations and/or central banks; OECD; World Bank staff estimates"
            },
            "countryISO3": {
              "const": "CHN"
            },
            "rights": {
              "$ref": "#/$defs/rights"
            }
          }
        }
      ]
    },
    "wdi-cn-inflation": {
      "allOf": [
        {
          "$ref": "#/$defs/source"
        },
        {
          "type": "object",
          "required": [
            "id",
            "family",
            "country",
            "indicator",
            "title",
            "unit",
            "sourceCredit",
            "countryISO3",
            "rights"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "const": "wdi-cn-inflation"
            },
            "family": {
              "const": "world-bank-indicator"
            },
            "country": {
              "const": "CN"
            },
            "indicator": {
              "const": "FP.CPI.TOTL.ZG"
            },
            "title": {
              "const": "China consumer-price inflation (annual %)"
            },
            "unit": {
              "const": "percent annual"
            },
            "sourceCredit": {
              "const": "International Monetary Fund, International Financial Statistics"
            },
            "countryISO3": {
              "const": "CHN"
            },
            "rights": {
              "$ref": "#/$defs/rights"
            }
          }
        }
      ]
    },
    "chirps3-africa-rainfall": {
      "allOf": [
        {
          "$ref": "#/$defs/source"
        },
        {
          "type": "object",
          "required": [
            "id",
            "family",
            "coverage",
            "title",
            "unit",
            "rights"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "const": "chirps3-africa-rainfall"
            },
            "family": {
              "const": "climate-hazards-archive"
            },
            "coverage": {
              "const": "Africa within CHIRPS v3 domain 60°S–60°N"
            },
            "title": {
              "const": "CHIRPS v3 precipitation, Africa-targeted subsets"
            },
            "unit": {
              "const": "millimetres daily precipitation"
            },
            "rights": {
              "$ref": "#/$defs/rights"
            }
          }
        }
      ]
    },
    "sse-market-data": {
      "allOf": [
        {
          "$ref": "#/$defs/source"
        },
        {
          "type": "object",
          "required": [
            "id",
            "family",
            "country",
            "title",
            "rights"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "const": "sse-market-data"
            },
            "family": {
              "const": "licensed-exchange-data"
            },
            "country": {
              "const": "CN"
            },
            "title": {
              "const": "Shanghai Stock Exchange market data"
            },
            "rights": {
              "$ref": "#/$defs/rights"
            }
          }
        }
      ]
    },
    "szse-market-data": {
      "allOf": [
        {
          "$ref": "#/$defs/source"
        },
        {
          "type": "object",
          "required": [
            "id",
            "family",
            "country",
            "title",
            "rights"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "const": "szse-market-data"
            },
            "family": {
              "const": "licensed-exchange-data"
            },
            "country": {
              "const": "CN"
            },
            "title": {
              "const": "Shenzhen Stock Exchange market data"
            },
            "rights": {
              "$ref": "#/$defs/rights"
            }
          }
        }
      ]
    },
    "china-nbs-website": {
      "allOf": [
        {
          "$ref": "#/$defs/source"
        },
        {
          "type": "object",
          "required": [
            "id",
            "family",
            "country",
            "title",
            "rights"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "const": "china-nbs-website"
            },
